# 工作台账 Go 版配置示例（部署后位于 {运行目录}/config/.env）
APP_NAME="工作台账"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://127.0.0.1:8080
LISTEN_ADDR=127.0.0.1:8080
SESSION_NAME=work_ledger_session
SESSION_LIFETIME_HOURS=12

# 数据库类型：sqlite（默认）/ mysql（MySQL 8.0+、MariaDB 10.5+）/ postgres（PostgreSQL 12+）
DB_DRIVER=sqlite
# SQLite 文件（默认 {运行目录}/data/app.sqlite）
DB_SQLITE_PATH=
# MySQL / PostgreSQL 连接（库需事先建好；MySQL 使用 utf8mb4 字符集）
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# 可选：PostgreSQL 为 disable/prefer/require/verify-full（默认 prefer）；MySQL 为 true/false/skip-verify（默认不加密）
DB_SSLMODE=

# AI：/api/v1 的 Bearer 令牌（openssl rand -hex 32 生成）
AI_API_TOKEN=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_TIMEOUT=120

# 二次验证
TOTP_ISSUER="工作台账"
REQUIRE_2FA=false

# 导入导出 / 备份上限
IMPORT_MAX_MB=10
IMPORT_MAX_ROWS=5000
EXPORT_MAX_ROWS=20000
BACKUP_MAX_UPLOAD_MB=50
BACKUP_MAX_JSON_MB=200

# 升级源（GitHub Release 地址）
UPDATE_BASE_URL=https://github.com/yooer/work-ledger
